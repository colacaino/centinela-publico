# Plantilla local sin secretos. Cloud Functions v2 lee estas variables en
# despliegue; no copies credenciales ni secretos de dispositivo aquí.
INCIDENT_TTL_SECONDS=120

# Comienza en false. Cambia a true solo después de registrar Play Integrity,
# tokens debug, verificar métricas y confirmar que todos los clientes migraron.
ENFORCE_APP_CHECK=false

# Opcional: proyecto que contiene los secretos ESP32 si es distinto del
# proyecto Firebase. La identidad de Functions necesita acceso de Secret Accessor.
ESP32_SECRET_PROJECT_ID=TU_PROYECTO_FIREBASE
